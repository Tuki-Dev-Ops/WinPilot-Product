{
  "name": "winpilot-product",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:client": "pnpm --filter @winpilot/b2c-client-a dev",
    "dev:admin": "pnpm --filter @winpilot/b2c-admin dev",
    "dev:ir": "pnpm --filter ir-client-a dev",
    "dev:ir-admin": "pnpm --filter ir-admin dev",
    "dev:fnb": "pnpm --filter fnb-client-a dev",
    "dev:fnb-admin": "pnpm --filter fnb-admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "figma:build": "pnpm --filter @winpilot/figma-plugin build",
    "figma:watch": "pnpm --filter @winpilot/figma-plugin watch",
    "spec:check": "tsx packages/spec/src/cli.ts",
    "spec:matrix": "tsx packages/spec/src/cli.ts --matrix",
    "ssot:tokens": "tsx packages/tokens/src/cli.ts",
    "ssot:extract": "tsx tools/extractor/src/cli.ts",
    "ssot:verify": "tsx tools/verifier/src/cli.ts",
    "ssot:selftest": "tsx tools/verifier/src/selftest.ts",
    "dev:internal": "pnpm --filter @winpilot/internal-admin dev",
    "sync:check": "tsx tools/check-component-sync.ts",
    "docs:check": "tsx tools/check-docs-coverage.ts",
    "overflow:check": "tsx tools/check-overflow.ts",
    "docs:build": "tsx tools/build-docs.ts",
    "docs:capture": "tsx tools/capture-page-views.ts",
    "docs:capture:admin": "tsx tools/capture-page-views.ts --app=admin",
    "docs:capture:internal": "tsx tools/capture-page-views.ts --app=internal",
    "weight:check": "tsx tools/check-weight.ts",
    "bind:check": "tsx tools/check-binding.ts",
    "pages:shoot": "tsx tools/shoot-pages.ts",
    "readme:build": "tsx tools/build-readme.ts",
    "sow:build": "tsx tools/build-sow.ts",
    "fsd:build": "tsx tools/build-fsd.ts"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "tsx": "^4.23.5",
    "typescript": "^5.7.3"
  }
}
